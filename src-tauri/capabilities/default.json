{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限: 窗口/事件 + 通知 + 文件对话框 + HTTP(用户可配任意LLM端点)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://localhost:**" },
        { "url": "http://127.0.0.1:**" }
      ]
    }
  ]
}
